rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if client is an authenticated administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Public visitors can ONLY create contact submissions
    match /contactSubmissions/{submission} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Public visitors can read projects and configuration settings
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Role document read-only for authentication checks
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Admins must be provisioned manually
    }
  }
}
